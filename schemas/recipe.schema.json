{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fatihcvs/repropack/raw/main/schemas/recipe.schema.json",
  "title": "ReproPack create input",
  "type": "object",
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1
    },
    "output": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[^\u0000]*$",
          "minLength": 1
        }
      ],
      "items": {
        "type": "string",
        "pattern": "^[^\u0000]*$"
      }
    },
    "setup": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[^\u0000]*$",
          "minLength": 1
        }
      ],
      "items": {
        "type": "string",
        "pattern": "^[^\u0000]*$"
      }
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "\\S"
    },
    "exitCode": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "maxFileBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5242880
    },
    "maxTotalBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20971520
    }
  },
  "required": [
    "root",
    "output",
    "files",
    "command",
    "signature"
  ]
}
